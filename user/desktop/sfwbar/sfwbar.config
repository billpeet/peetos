# PeetOS desktop session: the sfwbar panel (docs/desktop.md).
# A bar along the bottom edge: application menu, launchers, taskbar, tray
# and clock.

Set Term = "foot"

# Place new windows in a cascade.
placer {
  xorigin = 5
  yorigin = 5
  xstep = 5
  ystep = 5
  children = true
}

include("winops.widget")
module("appmenu")

layout {
  size = "100%"
  layer = "top"
  exclusive_zone = "auto"

  css = "* { min-height: 28px; }"

  # Application menu, built from /usr/share/applications by the appmenu
  # module (loaded above).
  button {
    value = "start-here"
    style = "startmenu"
    tooltip = "Applications"
    action = Menu "app_menu_system"
  }

  button {
    value = "utilities-terminal"
    style = "launcher"
    tooltip = "Terminal"
    action = Exec "foot"
  }
  button {
    value = "system-file-manager"
    style = "launcher"
    tooltip = "File Manager"
    action = Exec "thunar"
  }
  button {
    value = "system-search"
    style = "launcher"
    tooltip = "Run an application (Alt+F2)"
    action = Exec "fuzzel"
  }

  taskbar {
    style = "taskbar"
    rows = 1
    icons = true
    labels = true
    sort = false
    action[3] = Menu "winops"
    action[Drag] = Focus
  }

  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }

  tray {
    rows = 1
  }

  label {
    value = Time("%H:%M")
    style = "clock"
    interval = 1000
    tooltip = Time("%A %d %B %Y")
  }
}

#CSS
window#sfwbar {
  -GtkWidget-direction: bottom;
}

#hidden {
  -GtkWidget-visible: false;
}

button,
button image {
  min-height: 0px;
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
}

label {
  font: 13px Sans;
}

button#startmenu,
button#launcher,
button#module {
  border: none;
  padding: 3px;
  margin: 0px 1px;
  -GtkWidget-vexpand: true;
}

button#startmenu image,
button#launcher image,
button#module image {
  min-height: 20px;
  min-width: 20px;
  padding: 0px;
  margin: 0px;
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
}

button#startmenu:hover,
button#launcher:hover {
  background-color: rgba(213,213,213,0.6);
}

grid#taskbar {
  margin-left: 6px;
}

button#taskbar_item {
  padding: 3px 8px;
  border-radius: 3px;
  border-width: 0px;
  -GtkWidget-hexpand: false;
}

button#taskbar_item.focused {
  background-color: rgba(199,227,255,0.8);
}

button#taskbar_item.minimized label {
  color: alpha(currentColor, 0.6);
}

button#taskbar_item:hover {
  background-color: rgba(213,213,213,0.6);
}

button#taskbar_item grid {
  -GtkWidget-valign: center;
}

button#taskbar_item image {
  min-width: 18px;
  min-height: 18px;
  padding-right: 6px;
}

button#tray_item {
  margin: 0px;
  border: none;
  padding: 0px;
}

button#tray_item.passive {
  -GtkWidget-visible: false;
}

button#tray_item image {
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
  min-height: 16px;
  min-width: 16px;
  padding: 3px;
  margin: 0px;
  border: none;
}

#menu_item,
#menu_item image,
#menu_item label {
  -GtkWidget-halign: start;
}

#menu_item image {
  min-width: 16px;
  min-height: 16px;
  padding-right: 4px;
}

label#clock {
  padding-left: 8px;
  padding-right: 8px;
  -GtkWidget-vexpand: true;
  -GtkWidget-valign: center;
  font: 13px Sans;
}
